# Required for video generation. Get one from https://www.pexels.com/api/
PEXELS_API_KEY=

# trace, debug, info, warn, error, fatal, silent
LOG_LEVEL=debug
WHISPER_VERBOSE=false
PORT=3023
DEV=false

# Optional. Do not set this for the default Docker deployment because the image
# provides DATA_DIR_PATH=/app/data.
# DATA_DIR_PATH=
